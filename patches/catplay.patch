@@ -0,0 +1,44 @@
+use super::shared::ClientsDuplexTest;
+use crate::{LinkSession, LinkStatus, SessionType, files::FileTransferOutgoingSource};
+
+#[test]
+fn control_only_link_keeps_optional_payloads_queued_without_panicking() {
+    let mut test = ClientsDuplexTest::new();
+    test.sync();
+    // A head unit can negotiate control without the optional file/EA sessions.
+    test.client.local_lsp.sessions.retain(|s| s.session_type == SessionType::Control);
+    let file = test.client.files().reserve_file_tx().unwrap();
+    test.client.files().send_file(file, 0, &[], FileTransferOutgoingSource::VecData(vec![1, 2, 3]));
+    test.client.ea().enqueue_tx(vec![4, 5, 6]);
+    test.client.csm().enqueue_tx(vec![7, 8, 9]);
+    test.sync();
+    assert_eq!(test.client.status(), &LinkStatus::Writable);
+    assert_eq!(test.server_recv.pop_front(), Some(vec![7, 8, 9]));
+    assert!(test.client.files().has_tx_pending());
+    assert!(test.client.ea().has_tx_pending());
+}
+
+#[test]
+fn missing_control_session_does_not_consume_queued_identification() {
+    let mut test = ClientsDuplexTest::new();
+    test.sync();
+    test.client.local_lsp.sessions.clear();
+    test.client.csm().enqueue_tx(vec![7, 8, 9]);
+    test.client.reconcile(10);
+    assert!(test.client.csm().has_tx_pending());
+    assert!(test.client.retransmit_map.is_empty());
+}
+
+#[test]
+fn pending_ea_is_released_when_its_session_becomes_available() {
+    let mut test = ClientsDuplexTest::new();
+    test.sync();
+    let sessions = test.client.local_lsp.sessions.clone();
+    test.client.local_lsp.sessions.retain(|s| s.session_type == SessionType::Control);
+    test.client.ea().enqueue_tx(vec![4, 5, 6]);
+    assert!(test.client.next_payload().is_none());
+    assert!(test.client.ea().has_tx_pending());
+    test.client.local_lsp.sessions = sessions;
+    assert_eq!(test.client.next_payload(), Some((SessionType::ExternalAccessory, vec![4, 5, 6])));
+    assert!(!test.client.ea().has_tx_pending());
+}
