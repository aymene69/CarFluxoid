#!/bin/sh
# Launch projected Android Auto touchscreen dashboard (Rust + Slint HMI).
set -eu

start() {
 mkdir -p /run/carfluxoid-ui
 /usr/sbin/carfluxoid-supervise start carfluxoid-dashboard 1 -- \
  /opt/carfluxoid/bin/catplay-aa-rx --dashboard
}

stop() {
 /usr/sbin/carfluxoid-supervise stop carfluxoid-dashboard
}

case "${1:-start}" in
 start) start ;;
 stop) stop ;;
 restart) stop; start ;;
esac
