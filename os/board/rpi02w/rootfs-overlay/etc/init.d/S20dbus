#!/bin/sh
# Start system D-Bus daemon (required by BlueZ and catplay-aa-rx).
set -eu

case "${1:-start}" in
 start)
  mkdir -p /run/dbus /tmp/dbus
  chown dbus:dbus /run/dbus /tmp/dbus 2>/dev/null || true
  dbus-uuidgen --ensure=/tmp/dbus/machine-id 2>/dev/null || true
  rm -f /run/messagebus.pid
  dbus-daemon --system --fork
  ;;
 stop)
  [ -r /run/messagebus.pid ] && kill "$(cat /run/messagebus.pid)" 2>/dev/null || true
  rm -f /run/messagebus.pid
  ;;
 restart)
  "$0" stop
  "$0" start
  ;;
esac
