#!/bin/sh
# Launch wireless Apple CarPlay receiver (catplay-aa-rx).
set -eu

start() {
 /usr/sbin/carfluxoid-supervise start carfluxoid-radio 2 -- \
  /usr/sbin/carfluxoid-start-radio
}

stop() {
 /usr/sbin/carfluxoid-supervise stop carfluxoid-radio
}

case "${1:-start}" in
 start) start ;;
 stop) stop ;;
 restart) stop; start ;;
esac
