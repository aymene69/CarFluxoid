#!/bin/sh
# Persists bounded CarFluxoidOS vehicle diagnostics to /data (symlinked at /var/lib/carfluxoid).
set -u
DIR=/data
LOG="$DIR/car-diag.log"
PREV="$DIR/car-diag.prev.log"
TMP="$DIR/.car-diag.tmp"

mkdir -p "$DIR"
if [ -s "$LOG" ]; then
 mv -f "$LOG" "$PREV"
 sync
fi

snapshot() {
 label=$1
 {
  echo "=== SNAPSHOT $label ($(cat /proc/uptime 2>/dev/null || echo ?)) ==="
  if [ -r /sys/class/thermal/thermal_zone0/temp ]; then
   awk '{printf "temp=%.1f\x27C\n", $1/1000}' /sys/class/thermal/thermal_zone0/temp
  fi
  echo "--- aa_bulk ---"
  grep . /sys/module/aa_bulk/parameters/* 2>/dev/null || echo aa_bulk_absent
  echo "--- dmesg (head) ---"
  dmesg 2>/dev/null | grep -iE 'aa_bulk|dwc2|brcmfmac|bluetooth|hci|under-voltage|voltage' | head -n 30 || true
  echo "--- dmesg (tail) ---"
  dmesg 2>/dev/null | grep -iE 'aa_bulk|dwc2|brcmfmac|bluetooth|hci|under-voltage|voltage' | tail -n 40 || true
  echo "--- carfluxoid-dashboard ---"
  tail -n 30 /var/log/carfluxoid-dashboard.log 2>/dev/null || true
  echo "--- carfluxoid-aa ---"
  tail -n 80 /var/log/carfluxoid-aa.log 2>/dev/null || true
  echo "--- carfluxoid-radio (key events) ---"
  grep -E 'CP_|BT_QUIET|AUDIO_|VIDEO_' /var/log/carfluxoid-radio.log 2>/dev/null | tail -n 80 || true
  echo "--- carfluxoid-radio (tail) ---"
  tail -n 40 /var/log/carfluxoid-radio.log 2>/dev/null || true
  echo "--- session.log ---"
  if [ -r /run/carfluxoid/session.log ]; then
   lines=$(wc -l < /run/carfluxoid/session.log)
   if [ "$lines" -le 400 ]; then
    cat /run/carfluxoid/session.log
   else
    head -n 120 /run/carfluxoid/session.log
    echo "... ($lines lines total, showing tail 280) ..."
    tail -n 280 /run/carfluxoid/session.log
   fi
  else
   echo no_session_log
  fi
 } > "$TMP" 2>&1
 mv -f "$TMP" "$LOG"
 sync
}

for delay in 20 40 60 120; do
 sleep "$delay"
 snapshot "+${delay}s"
done
