# Architecture: Raspberry Pi Zero 2 W (BCM2710A1 Cortex-A53 64-bit)
BR2_aarch64=y
BR2_cortex_a53=y

# Internal glibc 2.41 toolchain (portable across ARM64 & x86_64 Docker hosts, ABI-compatible with catplay-aa-rx)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# System configuration
BR2_TARGET_GENERIC_HOSTNAME="carfluxoid"
BR2_TARGET_GENERIC_ISSUE="Welcome to CarFluxoidOS (Raspberry Pi Zero 2 W)"
BR2_TARGET_GENERIC_ROOT_PASSWD="c@rfluxoid"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW=n
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CARFLUXOID_PATH)/board/rpi02w/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CARFLUXOID_PATH)/board/rpi02w/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CARFLUXOID_PATH)/board/rpi02w/post-image.sh"

# Linux kernel (official Raspberry Pi 6.6 tree from Buildroot 2025.02 LTS + CarFluxoidOS fragment)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,576cc10e1ed50a9eacffc7a05c796051d7343ea4)/linux-576cc10e1ed50a9eacffc7a05c796051d7343ea4.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcmrpi3"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CARFLUXOID_PATH)/board/rpi02w/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-zero-2-w"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Raspberry Pi bootloader & DTB overlays (includes overlays/dwc2.dtbo)
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_CARFLUXOID_PATH)/board/rpi02w/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_CARFLUXOID_PATH)/board/rpi02w/cmdline.txt"

# Broadcom BCM43430/2 Wi-Fi + Bluetooth firmware & regulatory DB
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_WIRELESS_REGDB=y

# Out-of-tree CarFluxoid USB AOA gadget kernel module (aa_bulk.ko)
BR2_PACKAGE_AA_BULK=y

# Core system tools
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_GZIP=y

# Runtime shared libraries required by catplay-aa-rx
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_LIBUSB=y

# Networking & Bluetooth stack (AP mode + CarPlay BLE/BR-EDR)
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_EXPERIMENTAL=y

# Projected touchscreen dashboard runtime (Python 3 + Pillow w/ FreeType & PNG + minimal libx264 FFmpeg + DejaVu Sans)
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_PYTHON_PILLOW=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS=y
BR2_PACKAGE_X264=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_ENCODERS="libx264"
BR2_PACKAGE_FFMPEG_DECODERS="rawvideo"
BR2_PACKAGE_FFMPEG_MUXERS="h264"
BR2_PACKAGE_FFMPEG_DEMUXERS="rawvideo"
BR2_PACKAGE_FFMPEG_PARSERS="none"
BR2_PACKAGE_FFMPEG_BSFS="none"
BR2_PACKAGE_FFMPEG_PROTOCOLS="file pipe"
BR2_PACKAGE_FFMPEG_FILTERS="tpad format scale"

# Immutable SquashFS rootfs (ZSTD) + host disk image tooling
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_KMOD_XZ=y
